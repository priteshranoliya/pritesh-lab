<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>app.vigil.Vigil.helper</string>
  <key>ProgramArguments</key><array><string>/Library/PrivilegedHelperTools/app.vigil.Vigil.helper</string></array>
  <key>UserName</key><string>root</string>
  <key>RunAtLoad</key><true/>
  <!-- launchd restarts the helper if it ever exits; it reloads the session from disk. -->
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>2</integer>
  <key>Umask</key><integer>63</integer>
  <key>ProcessType</key><string>Interactive</string>
</dict></plist>
